{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "firebase.notifications.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/quotation-response.html",
        "function": "processQuotationResponse"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions-notifications",
    "codebase": "notifications",
    "runtime": "nodejs24"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
